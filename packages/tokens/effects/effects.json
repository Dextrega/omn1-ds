{
  "$description": "Figma effect styles (DropShadow/Level 1\u20134). The Tokens Studio export carries no effects, so they are authored here from the Figma styles and read by scripts/build.mjs. Re-read them with use_figma (getLocalEffectStylesAsync) when design changes them.",
  "drop-shadow": {
    "level-1": {
      "$type": "shadow",
      "$extensions": {
        "com.omn1": {
          "figma": "DropShadow/Level 1"
        }
      },
      "$value": [
        {
          "offsetX": 0,
          "offsetY": 1,
          "blur": 2,
          "spread": 0,
          "color": "#000000",
          "alpha": 0.08
        },
        {
          "offsetX": 0,
          "offsetY": 1,
          "blur": 3,
          "spread": 0,
          "color": "#000000",
          "alpha": 0.08
        }
      ]
    },
    "level-2": {
      "$type": "shadow",
      "$extensions": {
        "com.omn1": {
          "figma": "DropShadow/Level 2"
        }
      },
      "$value": [
        {
          "offsetX": 0,
          "offsetY": 4,
          "blur": 6,
          "spread": -1,
          "color": "#000000",
          "alpha": 0.12
        },
        {
          "offsetX": 0,
          "offsetY": 1,
          "blur": 6,
          "spread": 0,
          "color": "#000000",
          "alpha": 0.08
        }
      ]
    },
    "level-3": {
      "$type": "shadow",
      "$extensions": {
        "com.omn1": {
          "figma": "DropShadow/Level 3"
        }
      },
      "$value": [
        {
          "offsetX": 0,
          "offsetY": 8,
          "blur": 16,
          "spread": -4,
          "color": "#000000",
          "alpha": 0.2
        },
        {
          "offsetX": 0,
          "offsetY": 4,
          "blur": 12,
          "spread": 0,
          "color": "#000000",
          "alpha": 0.06
        }
      ]
    },
    "level-4": {
      "$type": "shadow",
      "$extensions": {
        "com.omn1": {
          "figma": "DropShadow/Level 4"
        }
      },
      "$value": [
        {
          "offsetX": 0,
          "offsetY": 12,
          "blur": 24,
          "spread": -2,
          "color": "#000000",
          "alpha": 0.24
        },
        {
          "offsetX": 0,
          "offsetY": 10,
          "blur": 16,
          "spread": 0,
          "color": "#000000",
          "alpha": 0.2
        }
      ]
    }
  }
}
